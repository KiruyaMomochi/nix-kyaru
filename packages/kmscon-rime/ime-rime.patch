+bool kmscon_pty_is_password_prompt(struct kmscon_pty *pty)
+{
+	struct termios tios;
+
+	if (!pty || !pty_is_open(pty))
+		return false;
+
+	if (tcgetattr(pty->fd, &tios) < 0)
+		return false;
+
+	/* Canonical mode with ECHO disabled indicates login/getpass/passwd. */
+	return (tios.c_lflag & ICANON) && !(tios.c_lflag & ECHO);
+}
