@@ -437,7 +438,8 @@ static bool is_vbar(enum tsm_screen_cursor_style style)
  *
  * Returns: 0 on success or negative error code if this glyph couldn't be drawn.
  */
-int kmscon_text_draw(struct kmscon_text *txt, struct tsm_screen *con, bool cursor_blink)
+int kmscon_text_draw(struct kmscon_text *txt, struct tsm_screen *con, bool cursor_blink,
+		     const struct kmscon_text_overlay *overlay)
 {
 	const struct tsm_screen_cell *cells;
 	struct kmscon_cursor cursor = {0};
@@ -469,6 +471,63 @@ int kmscon_text_draw(struct kmscon_text *txt, struct tsm_screen *con, bool curso
 		} else if (is_vbar(style))
 			cursor.cell.ch = FONT_VBAR;
 	}
+
+	if (overlay && overlay->cells && overlay->len > 0 && txt->cols > 0 && txt->rows > 0) {
+		size_t total = (size_t)txt->cols * txt->rows;
+
+		if (total > txt->overlay_cap) {
+			struct tsm_screen_cell *nbuf =
+				realloc(txt->overlay_buf, total * sizeof(*nbuf));
+			if (nbuf) {
+				txt->overlay_buf = nbuf;
+				txt->overlay_cap = total;
+			}
+		}
+
+		if (txt->overlay_buf && txt->overlay_cap >= total) {
+			unsigned int row, x0, w, i;
+			struct tsm_screen_cell *line;
+			const struct tsm_screen_cell *orig_line;
+
+			memcpy(txt->overlay_buf, cells, total * sizeof(*cells));
+
+			if (txt->rows == 1)
+				row = 0;
+			else if (cursor.y + 1 < txt->rows)
+				row = cursor.y + 1;
+			else
+				row = cursor.y - 1;
+
+			w = overlay->len < txt->cols ? overlay->len : txt->cols;
+			x0 = cursor.x < txt->cols ? cursor.x : 0;
+			if (x0 + w > txt->cols)
+				x0 = txt->cols - w;
+
+			line = &txt->overlay_buf[row * txt->cols];
+			orig_line = &cells[row * txt->cols];
+
+			if (x0 > 0 && orig_line[x0 - 1].ch != 0 &&
+			    orig_line[x0 - 1].ch != ' ' &&
+			    tsm_ucs4_get_width(orig_line[x0 - 1].ch) == 2) {
+				line[x0 - 1].ch = ' ';
+			}
+
+			for (i = 0; i < w; i++)
+				line[x0 + i] = overlay->cells[i];
+
+			if (w < overlay->len && w > 0 && overlay->cells[w].ch == 0)
+				line[x0 + w - 1].ch = ' ';
+
+			if (x0 + w < txt->cols && line[x0 + w].ch == 0)
+				line[x0 + w].ch = ' ';
+
+			if (row == cursor.y && cursor.x >= x0 && cursor.x < x0 + w)
+				cursor.visible = false;
+
+			return txt->ops->draw(txt, txt->overlay_buf, &cursor);
+		}
+	}
+
 	return txt->ops->draw(txt, cells, &cursor);
 }
 
