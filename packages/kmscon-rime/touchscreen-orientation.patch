+static void touchscreen_update_coords(struct input_dev *dev)
+{
+	int64_t span_x = (int64_t)dev->pointer.max_x - dev->pointer.min_x;
+	int64_t span_y = (int64_t)dev->pointer.max_y - dev->pointer.min_y;
+	int64_t rx = (int64_t)dev->pointer.abs_x - dev->pointer.min_x;
+	int64_t ry = (int64_t)dev->pointer.abs_y - dev->pointer.min_y;
+	int64_t max_x = dev->input->pointer_max_x;
+	int64_t max_y = dev->input->pointer_max_y;
+
+	if (span_x <= 0 || span_y <= 0)
+		return;
+	if (rx < 0)
+		rx = 0;
+	else if (rx > span_x)
+		rx = span_x;
+	if (ry < 0)
+		ry = 0;
+	else if (ry > span_y)
+		ry = span_y;
+
+	switch (dev->input->pointer_orientation) {
+	default:
+	case 0: /* OR_NORMAL */
+		dev->pointer.x = (rx * max_x) / span_x;
+		dev->pointer.y = (ry * max_y) / span_y;
+		break;
+	case 1: /* OR_RIGHT */
+		dev->pointer.x = (ry * max_x) / span_y;
+		dev->pointer.y = ((span_x - rx) * max_y) / span_x;
+		break;
+	case 2: /* OR_UPSIDE_DOWN */
+		dev->pointer.x = ((span_x - rx) * max_x) / span_x;
+		dev->pointer.y = ((span_y - ry) * max_y) / span_y;
+		break;
+	case 3: /* OR_LEFT */
+		dev->pointer.x = ((span_y - ry) * max_x) / span_y;
+		dev->pointer.y = (rx * max_y) / span_x;
+		break;
+	}
+}
+
 void pointer_dev_sync(struct input_dev *dev)
 {
 	struct input_pointer_event pev = {0};
 
+	if (dev->pointer.kind == POINTER_TOUCHSCREEN) {
+		if (dev->pointer.touch_moved ||
+		    (dev->pointer.touch_btn_pending && dev->pointer.touch_btn_pressed)) {
+			dev->pointer.touch_moved = false;
+			touchscreen_update_coords(dev);
+			pointer_dev_send_move(dev);
+		}
+		if (dev->pointer.touch_btn_pending) {
+			bool pressed = dev->pointer.touch_btn_pressed;
+			bool dbl = dev->pointer.touch_btn_dbl;
+
+			dev->pointer.touch_btn_pending = false;
+			dev->pointer.pressed_button = pressed ? 0 : BUTTON_NONE;
+			pointer_dev_send_button(dev, 0, pressed, dbl);
+		}
+	}
+
 	pev.event = POINTER_SYNC;
 
 	shl_hook_call(dev->input->pointer_hook, dev->input, &pev);
@@ -119,6 +177,9 @@ static void pointer_dev_abs_x(struct input_dev *dev, int32_t value)
 		}
 		break;
 	case POINTER_TOUCHSCREEN:
+		dev->pointer.abs_x = value;
+		dev->pointer.touch_moved = true;
+		return;
 	case POINTER_VMOUSE:
 		dev->pointer.x = ((value - dev->pointer.min_x) * dev->input->pointer_max_x) /
 				 (dev->pointer.max_x - dev->pointer.min_x);
@@ -151,6 +212,9 @@ static void pointer_dev_abs_y(struct input_dev *dev, int32_t value)
 		}
 		break;
 	case POINTER_TOUCHSCREEN:
+		dev->pointer.abs_y = value;
+		dev->pointer.touch_moved = true;
+		return;
 	case POINTER_VMOUSE:
 		dev->pointer.y = ((value - dev->pointer.min_y) * dev->input->pointer_max_y) /
 				 (dev->pointer.max_y - dev->pointer.min_y);
@@ -214,6 +278,19 @@ void pointer_dev_button(struct input_dev *dev, uint16_t code, int32_t value)
 			dev->pointer.touchpad_needs_sync_off_x = true;
 			dev->pointer.touchpad_needs_sync_off_y = true;
 		}
+		if (dev->pointer.kind == POINTER_TOUCHSCREEN &&
+		    !(dev->capabilities & DEVICE_HAS_MOUSE_BTN)) {
+			if (pressed) {
+				clock_gettime(CLOCK_MONOTONIC, &tp);
+				elapsed = (tp.tv_sec - dev->pointer.last_click.tv_sec) * 1000 +
+					  (tp.tv_nsec - dev->pointer.last_click.tv_nsec) / 1000000;
+				dbl_click = (elapsed < 500);
+				dev->pointer.last_click = tp;
+			}
+			dev->pointer.touch_btn_pending = true;
+			dev->pointer.touch_btn_pressed = pressed;
+			dev->pointer.touch_btn_dbl = dbl_click;
+		}
 		break;
 	default:
 		break;
